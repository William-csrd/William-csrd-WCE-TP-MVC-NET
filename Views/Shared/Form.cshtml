@model TPLOCAL1.Models.FormModel
@{
    Layout = null;
}
<!Doctype html>
<html lang="fr">
<head>
       <meta charset="utf-8" />
       <title>Formulaire </title>
       <link rel="stylesheet" href="~/resources/Index.css" />
</head>
<body>
<header>
    <img src="~/resources/GroupeHN.png" class="image" alt="GroupeHN" />
     <h1>Formulaire TP HN avis </h1>
</header>
<nav>
       <ul>
            <li><a href="/Home/Index">Accueil </a></li>
            <li><a href="/Home/Index/OpinionList">Liste avis</a></li>
        </uL>
</nav>
<section>
<form action="/Home/ValidationFormulaire" method="post">

    <!-- Informations Personnelles -->

<table>
                <tr>
                    <td colspan="2" class="title-row">Informations personnelles</td>
                </tr>
 <tr>
      <td>Nom</td>
                    <td colspan="2">
                        <input type="text" asp-for="Nom" placeholder="votre nom" />
                        <span asp-validation-for="Nom"></span>
                    </td>
 </tr>
 <tr>
      <td>Prénom</td>
                    <td colspan="2">
                    <input type="text" asp-for="Prénom" placeholder="votre prénom" />
                    <span asp-validation-for="Prénom"></span>
                    </td>
 </tr>
 <tr>
       <td>Genre</td>
       <td colspan="2">
             <select asp-for="Genre">
             <option value="">Selectionner un sexe</option>
             <option value="Homme">Homme</option>
             <option value="Femme">Femme</option>
             <option value="Autre">Autre</option>
             </select>
             <span asp-validation-for="Genre"></span>
      </td>
 </tr>
 <tr>
      <td>Adresse</td>
                    <td colspan="2">
                        <input type="text" asp-for="Adresse" placeholder="votre adresse" />
                        <span asp-validation-for="Adresse"></span>
                    </td>
 </tr>
 <tr>
      <td>Code Postal</td>
                        <td colspan="2">
                            <input type="text" asp-for="CodePostal" placeholder="votre code postal" />
                            <span asp-validation-for="CodePostal"></span>
                        </td>
 </tr>
 <tr>
      <td>Ville</td>
                        <td colspan="2">
                            <input type="text" asp-for="Ville" placeholder="votre ville" />
                            <span asp-validation-for="Ville"></span>
                        </td>
 </tr>
 <tr>
      <td>Adresse mail</td>
                        <td colspan="2">
                            <input type="text" asp-for="Email" placeholder="votre adresse mail" />
                            <span asp-validation-for="Email"></span>
                        </td>
 </tr>
</table>


     <!-- Informations formation suivie -->

 <table>
                <tr>
                    <td colspan="2" class="title-row">Informations sur la formation </td>
                </tr>
 
<tr> 
     <td>Date début formation</td>
                        <td colspan="2">
                            <input type="date" asp-for="DateDebut" />
                            <span asp-validation-for="DateDebut"></span>
                        </td>
</tr>
<tr>
     <td>Formation suivie</td>
                    <td colspan="2">
                        <select asp-for="TypeFormation">
                            <option value="">Selectionner une formation</option>
                            <option value="Formation Cobol">Formation Cobol</option>
                            <option value="Formation par objet">Formation par objet</option>
                            <option value="Formation à double compétence">Formation à double compétence</option>
                        </select>
                        <span asp-validation-for="TypeFormation"></span>
                    </td>
</tr>
</table>

    <!-- Avis sur la formation-->

<table>
                    <tr>
                        <td colspan="2" class="title-row">Avis sur la formation</td>
                    </tr>

 <tr>
      <td>Formation Cobol</td>
      <td colspan="2">
          <input type="text" asp-for="AvisCobol" />
          <span asp-validation-for="AvisCobol"></span>
      </td>
 </tr>
 <tr>
      <td>Formation C#</td>
      <td colspan="2">
          <input type="text" asp-for="AvisCSharp" />
          <span asp-validation-for="AvisCSharp"></span>
      </td>
</tr>
</table>

<button type="submit">Valider</button>    
</form>
</section>
</body>
</html>

