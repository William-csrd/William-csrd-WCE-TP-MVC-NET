@model TPLOCAL1.Models.FormModel
<!Doctype html>
<html lang="fr">
<head>
       <meta charset="utf-8" />
       <title>Page de Validation </title>
       <link rel="stylesheet" href="~/resources/Index.css" />
</head>
<body>
<header>
    <img src="~/resources/GroupeHN.png" class="image" alt="GroupeHN" />
     <h1>Page de Validation </h1>
</header>
<nav>
       <ul>
            <li><a href="/Home/Index">Accueil </a></li>
            <li><a href="/Home/Index/OpinionList">Liste avis</a></li>
        </uL>
</nav>
<section>
        <p class="validation-message">Votre formulaire a bien été pris en compte</p>
        <!-- Informations Personnelles -->
<table>
            <tr>
                <td colspan="2" class="title-row">Informations personnelles</td>
            </tr>
        <tr>
                <td>Nom</td>
                <td>@Model.Nom</td>
       </tr>
            <tr>
                <td>Prénom</td>
                <td>@Model.Prénom</td>
            </tr>   
         <tr>
                <td>Genre</td>
                <td>@Model.Genre</td>
       </tr>
            <tr>
                <td>Adresse</td>
                <td>@Model.Adresse</td>
            </tr>            <tr>
                <td>Code Postal</td>
                <td>@Model.CodePostal</td>
            </tr>
            <tr>
                <td>Ville</td>
                <td>@Model.Ville</td>
            </tr>
           
                <tr>
                    <td>Adresse mail</td>
                    <td>@Model.Email</td>
                </tr>
</table>
        <!-- Informations formation suivie -->
<table>
            <tr>
                <td colspan="2" class="title-row">Informations sur la formation </td>
            </tr>
    <tr>
        <td>Date début formation</td>
                    <td>@(Model.DateDebut.HasValue ? Model.DateDebut.Value.ToString("dd/MM/yyyy") : "")</td>
    </tr>
    <tr>
        <td>Formation suivie</td>
        <td>@Model.TypeFormation</td>
    </tr>
</table>
        <!--Avis sur la formation -->
<table>
    <tr>
        <td colspan="2" class="title-row">Avis sur la formation</td>
    </tr>

            <tr>
                <td>Formation Cobol</td>
                <td>@Model.AvisCobol</td>
            </tr>
            <tr>
                <td>Formation C#</td>
                <td>@Model.AvisCSharp</td>
            </tr>
</table>
</section>
</body>
</html>
